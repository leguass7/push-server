# Banco (Prisma) — dev Docker (porta 5433, para não colidir com o Postgres do bt-pro)
# Se a senha tiver # ou @, percent-encode na URL (# → %23, @ → %40).
DATABASE_URL=postgresql://pushserver:pushserver_dev@localhost:5433/push_server?schema=public

# Porta HTTP do serviço
PORT=3000

# VAPID (gerar com: pnpm vapid:generate)
VAPID_SUBJECT=mailto:admin@s4sbr.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Token compartilhado (Bearer) que os clientes (ex.: bt-pro) devem enviar em
# `Authorization: Bearer <token>`. Vazio = autenticação desligada (uso local/dev
# ou enquanto o caller — ex. bt-pro's push-server-client.ts — ainda não envia o
# header). Ver docs/adr/0004-compatibilidade-com-bt-pro.md antes de definir em produção.
API_TOKEN=

# Scheduler (polling — ver docs/adr/0003-scheduler-por-polling.md)
POLL_INTERVAL_MS=30000
DISPATCH_BATCH_SIZE=20
MAX_SEND_ATTEMPTS=3

# Logging (pino): fatal|error|warn|info|debug|trace
LOG_LEVEL=info
